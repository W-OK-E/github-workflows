    <geom pos="4.2 -0.03 0.010" type="box" size="0.06 0.07 0.010" rgba="0.4 0.4 0.4 1" />
    <geom pos="4.5 0.06 0.014" type="box" size="0.05 0.05 0.014" rgba="0.4 0.4 0.4 1" />
    <geom pos="4.8 -0.09 0.006" type="box" size="0.08 0.04 0.006" rgba="0.4 0.4 0.4 1" />

    <!-- A few slightly larger bumps for variety -->
    <geom pos="1.0 0.0 0.010" type="sphere" size="0.03" rgba="0.5 0.5 0.5 1" />
    <geom pos="2.0 0.05 0.010" type="sphere" size="0.025" rgba="0.5 0.5 0.5 1" />
    <geom pos="3.0 -0.04 0.010" type="sphere" size="0.035" rgba="0.5 0.5 0.5 1" />
