    <geom pos="1.8 0.12 0.012" type="box" size="0.06 0.05 0.012" rgba="0.4 0.4 0.4 1" />
    <geom pos="2.1 -0.10 0.006" type="box" size="0.05 0.07 0.006" rgba="0.4 0.4 0.4 1" />
    <geom pos="2.4 0.00 0.015" type="box" size="0.08 0.04 0.015" rgba="0.4 0.4 0.4 1" />
    <geom pos="2.7 0.08 0.009" type="box" size="0.04 0.06 0.009" rgba="0.4 0.4 0.4 1" />
    <geom pos="3.0 -0.12 0.011" type="box" size="0.06 0.05 0.011" rgba="0.4 0.4 0.4 1" />
    <geom pos="3.3 0.03 0.008" type="box" size="0.05 0.05 0.008" rgba="0.4 0.4 0.4 1" />
