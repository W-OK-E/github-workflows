    <geom pos="0.9 -0.08 0.008" type="box" size="0.05 0.05 0.008" rgba="0.4 0.4 0.4 1" />
    <geom pos="1.2 0.10 0.010" type="box" size="0.07 0.04 0.010" rgba="0.4 0.4 0.4 1" />
