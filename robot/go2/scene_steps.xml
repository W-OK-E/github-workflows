<mujoco model="go2 scene">
  <include file="go2.xml" />

  <statistic center="0 0 0.1" extent="0.8" />

  <visual>
    <headlight diffuse="0.6 0.6 0.6" ambient="0.3 0.3 0.3" specular="0 0 0" />
    <rgba haze="0.15 0.25 0.35 1" />
    <global azimuth="-130" elevation="-20" />
  </visual>

  <asset>
    <texture type="skybox" builtin="gradient" rgb1="0.3 0.5 0.7" rgb2="0 0 0" width="512" height="3072" />
    <texture type="2d" name="groundplane" builtin="checker" mark="edge" rgb1="0.2 0.3 0.4" rgb2="0.1 0.2 0.3" markrgb="0.8 0.8 0.8" width="300" height="300" />
    <material name="groundplane" texture="groundplane" texuniform="true" texrepeat="5 5" reflectance="0.2" />
  </asset>

  <worldbody>
    <light pos="0 0 1.5" dir="0 0 -1" directional="true" />
    <geom name="floor" size="0 0 0.05" type="plane" material="groundplane" />

    <!-- Ascending stairs (height 0.03 each, 0.2m deep) starting at x=1.0 -->
    <geom pos="1.1 0.0 0.015" type="box" size="0.10 0.30 0.015" rgba="0.5 0.35 0.25 1" />
    <geom pos="1.3 0.0 0.045" type="box" size="0.10 0.30 0.045" rgba="0.5 0.35 0.25 1" />
    <geom pos="1.5 0.0 0.075" type="box" size="0.10 0.30 0.075" rgba="0.5 0.35 0.25 1" />

    <!-- Flat platform at the top -->
    <geom pos="1.8 0.0 0.09" type="box" size="0.20 0.30 0.09" rgba="0.4 0.3 0.25 1" />

    <!-- Descending stairs -->
    <geom pos="2.1 0.0 0.075" type="box" size="0.10 0.30 0.075" rgba="0.5 0.35 0.25 1" />
    <geom pos="2.3 0.0 0.045" type="box" size="0.10 0.30 0.045" rgba="0.5 0.35 0.25 1" />
    <geom pos="2.5 0.0 0.015" type="box" size="0.10 0.30 0.015" rgba="0.5 0.35 0.25 1" />

    <!-- Scattered bumps between stair sets -->
    <geom pos="2.8 0.05 0.02" type="box" size="0.06 0.08 0.02" rgba="0.35 0.35 0.45 1" />
    <geom pos="3.1 -0.06 0.015" type="box" size="0.07 0.06 0.015" rgba="0.35 0.35 0.45 1" />
    <geom pos="3.4 0.08 0.025" type="box" size="0.05 0.07 0.025" rgba="0.35 0.35 0.45 1" />

    <!-- Second stair set (slightly higher: 0.04 each) -->
    <geom pos="3.8 0.0 0.02" type="box" size="0.10 0.30 0.02" rgba="0.45 0.3 0.2 1" />
    <geom pos="4.0 0.0 0.06" type="box" size="0.10 0.30 0.06" rgba="0.45 0.3 0.2 1" />
    <geom pos="4.2 0.0 0.10" type="box" size="0.10 0.30 0.10" rgba="0.45 0.3 0.2 1" />
    <geom pos="4.5 0.0 0.12" type="box" size="0.20 0.30 0.12" rgba="0.4 0.25 0.2 1" />

    <!-- Surface roughness -->
    <geom pos="0.4 0.03 0.008" type="box" size="0.04 0.04 0.008" rgba="0.4 0.4 0.4 1" />
    <geom pos="0.7 -0.05 0.010" type="box" size="0.05 0.03 0.010" rgba="0.4 0.4 0.4 1" />
    <geom pos="3.6 0.02 0.012" type="box" size="0.04 0.05 0.012" rgba="0.4 0.4 0.4 1" />
  </worldbody>
</mujoco>
